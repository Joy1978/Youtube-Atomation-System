# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional - override the default model. Check the latest available
# flash model name at https://ai.google.dev/gemini-api/docs/models
# before running (model names change over time - Google ships new
# ones often, and older free-tier models get cut off for new users).
GEMINI_MODEL=gemini-3.1-flash-lite

PEXELS_API_KEY=your_pexels_api_key_here

GOOGLE_SHEET_ID=your_google_sheet_id_here